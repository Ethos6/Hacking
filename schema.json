{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ethos6/Hacking/schema.json",
  "title": "Hacking category file",
  "type": "object",
  "required": ["category", "description", "resources"],
  "additionalProperties": false,
  "properties": {
    "category": { "type": "string" },
    "description": { "type": "string" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "url", "type", "description", "added"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "maxLength": 60 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "type": { "enum": ["course", "platform", "lab", "tool", "reference", "list"] },
          "description": { "type": "string", "minLength": 20, "maxLength": 180 },
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$", "description": "GitHub owner/name; enables the weekly health check." },
          "level": { "enum": ["beginner", "intermediate", "advanced"] },
          "free": { "type": "boolean" },
          "note": { "type": "string", "maxLength": 160 },
          "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "added": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
